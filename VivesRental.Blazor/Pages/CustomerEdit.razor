@page "/customers/{Id:guid}/edit"
@using VivesRental.Blazor.Models
@inject VivesRental.Blazor.Services.CustomerService CustomerService
@inject NavigationManager Nav

<h1>Edit customer</h1>

@if (loading)
{
    <p><em>Loading...</em></p>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">@error</div>
}
else if (customer is null)
{
    <div class="alert alert-warning">Customer not found.</div>
}
else
{
    <EditForm Model="model" OnValidSubmit="Save">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">First name</label>
            <InputText class="form-control" @bind-Value="model.FirstName" />
        </div>

        <div class="mb-3">
            <label class="form-label">Last name</label>
            <InputText class="form-control" @bind-Value="model.LastName" />
        </div>

        <div class="mb-3">
            <label class="form-label">Email</label>
            <InputText class="form-control" @bind-Value="model.Email" />
        </div>

        <div class="mb-3">
            <label class="form-label">Phone number</label>
            <InputText class="form-control" @bind-Value="model.PhoneNumber" />
        </div>

        <button class="btn btn-primary" disabled="@saving">Save</button>
        <button type="button" class="btn btn-outline-secondary ms-2" @onclick="Cancel" disabled="@saving">Cancel</button>

        <button type="button" class="btn btn-outline-danger ms-2" @onclick="AskDelete" disabled="@saving">
            Delete
        </button>
    </EditForm>

    @if (confirmDelete)
    {
        <div class="alert alert-warning mt-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <strong>Delete this customer?</strong>
                    <div class="small">This action cannot be undone.</div>
                </div>
                <div>
                    <button class="btn btn-danger" @onclick="Delete" disabled="@saving">Confirm</button>
                    <button class="btn btn-outline-secondary ms-2" @onclick="CancelDelete" disabled="@saving">Cancel</button>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private bool loading = true;
    private bool saving;
    private bool confirmDelete;

    private string? error;
    private CustomerDto? customer;
    private CustomerRequest model = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            customer = await CustomerService.GetCustomerAsync(Id);
            if (customer is not null)
            {
                model = new CustomerRequest
                {
                    FirstName = customer.FirstName,
                    LastName = customer.LastName,
                    Email = customer.Email,
                    PhoneNumber = customer.PhoneNumber
                };
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task Save()
    {
        error = null;
        saving = true;

        try
        {
            var updated = await CustomerService.UpdateCustomerAsync(Id, model);
            if (updated is null)
            {
                error = "Customer not found.";
                return;
            }

            Nav.NavigateTo($"/customers/{Id}");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private void Cancel()
    {
        Nav.NavigateTo($"/customers/{Id}");
    }

    private void AskDelete()
    {
        confirmDelete = true;
    }

    private void CancelDelete()
    {
        confirmDelete = false;
    }

    private async Task Delete()
    {
        error = null;
        saving = true;

        try
        {
            var ok = await CustomerService.DeleteCustomerAsync(Id);
            if (!ok)
            {
                error = "Customer not found.";
                return;
            }

            Nav.NavigateTo("/customers");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            saving = false;
            confirmDelete = false;
        }
    }
}
