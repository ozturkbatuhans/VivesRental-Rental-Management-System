@page "/reservations"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using VivesRental.Blazor.Models
@inject VivesRental.Blazor.Services.ArticleReservationService ReservationService
@inject VivesRental.Blazor.Services.CustomerService CustomerService
@inject VivesRental.Blazor.Services.ArticleService ArticleService
@inject NavigationManager Nav

<h3>Reservations</h3>

<div class="card mb-3">
    <div class="card-body">
        <div class="row g-2">
            <div class="col-12 col-md-4">
                <label class="form-label">Customer</label>
                <select class="form-select" @bind="selectedCustomerId" disabled="@isBusy">
                    <option value="@Guid.Empty">-- Select customer --</option>
                    @foreach (var c in customers)
                    {
                        <option value="@c.Id">@($"{c.FirstName} {c.LastName} ({c.Email})")</option>
                    }
                </select>
                <div class="form-text">You can also filter reservations by selecting a customer.</div>
            </div>

            <div class="col-12 col-md-4">
                <label class="form-label">Article</label>
                <select class="form-select" @bind="selectedArticleId" disabled="@isBusy">
                    <option value="@Guid.Empty">-- Select article --</option>
                    @foreach (var a in availableArticles)
                    {
                        <option value="@a.Id">@($"{a.ProductName} - {a.Id}")</option>
                    }
                </select>
                <div class="form-text">Only articles with status Available are shown.</div>
            </div>

            <div class="col-12 col-md-2">
                <label class="form-label">From</label>
                <InputDate class="form-control" @bind-Value="fromDate" disabled="@isBusy" />
            </div>

            <div class="col-12 col-md-2">
                <label class="form-label">Until (optional)</label>
                <InputDate class="form-control" @bind-Value="untilDate" disabled="@isBusy" />
            </div>
        </div>

        <!-- ✅ PDF requirement: search reservations by customer name -->
        <div class="row g-2 mt-2">
            <div class="col-12 col-md-6">
                <label class="form-label">Search by customer name</label>
                <input class="form-control"
                       placeholder="Type a customer name..."
                       @bind="customerNameSearch"
                       @bind:event="oninput"
                       disabled="@isBusy" />
            </div>
        </div>

        <div class="mt-3">
            <button class="btn btn-primary" type="button" @onclick="CreateReservation" disabled="@isBusy">
                Create reservation
            </button>
            <button class="btn btn-outline-secondary ms-2" type="button" @onclick="ReloadAll" disabled="@isBusy">
                Refresh
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="alert alert-danger mt-3 d-flex justify-content-between align-items-center">
                <span>@error</span>
                <button class="btn btn-sm btn-outline-light" type="button" @onclick="ReloadAll" disabled="@isBusy">Retry</button>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(message))
        {
            <div class="alert alert-success mt-3">@message</div>
        }
    </div>
</div>

@if (isLoading)
{
    <p><em>Loading...</em></p>
}
else if (FilteredReservations.Count == 0)
{
    <p>No reservations found.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Customer</th>
                    <th>Article</th>
                    <th>From</th>
                    <th>Until</th>
                    <th style="width: 140px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in FilteredReservations)
                {
                    <tr>
                        <td>@r.CustomerName</td>
                        <td>@r.ArticleName</td>
                        <td>@r.FromDateTime.ToString("yyyy-MM-dd")</td>
                        <td>@FormatUntil(r.UntilDateTime)</td>
                        <td>
                            <button class="btn btn-outline-danger" type="button"
                                    @onclick="() => DeleteReservation(r)"
                                    disabled="@isBusy">
                                Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<CustomerDto> customers = new();
    private List<ArticleDto> availableArticles = new();
    private List<ArticleReservationDto> reservations = new();

    private Guid selectedCustomerId = Guid.Empty;
    private Guid selectedArticleId = Guid.Empty;

    // ✅ PDF: search by customer name
    private string customerNameSearch = string.Empty;

    private DateTime fromDate = DateTime.Today;
    private DateTime? untilDate;

    private bool isLoading = true;
    private bool isBusy;

    private string? error;
    private string? message;

    private List<ArticleReservationDto> FilteredReservations
    {
        get
        {
            IEnumerable<ArticleReservationDto> query = reservations;

            if (selectedCustomerId != Guid.Empty)
            {
                query = query.Where(r => r.CustomerId == selectedCustomerId);
            }

            if (!string.IsNullOrWhiteSpace(customerNameSearch))
            {
                query = query.Where(r =>
                    !string.IsNullOrWhiteSpace(r.CustomerName) &&
                    r.CustomerName.Contains(customerNameSearch, StringComparison.OrdinalIgnoreCase));
            }

            return query.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await ReloadAll();
    }

    private async Task ReloadAll()
    {
        isLoading = true;
        isBusy = true;
        error = null;
        message = null;

        try
        {
            customers = await CustomerService.GetCustomersAsync();

            var allArticles = await ArticleService.GetArticlesAsync();

            // 0 = Available
            availableArticles = allArticles
                .Where(a => a.Status == 0)
                .OrderBy(a => a.ProductName)
                .ToList();

            reservations = await ReservationService.GetAllAsync();
        }
        catch (HttpRequestException)
        {
            error = "The API is not reachable. Please try again later.";
        }
        catch (UnauthorizedAccessException)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
            isBusy = false;
        }
    }

    private async Task CreateReservation()
    {
        error = null;
        message = null;

        if (selectedCustomerId == Guid.Empty || selectedArticleId == Guid.Empty)
        {
            error = "Please select both a customer and an article.";
            return;
        }

        if (untilDate.HasValue && untilDate.Value.Date < fromDate.Date)
        {
            error = "Until date must be the same or after the From date.";
            return;
        }

        isBusy = true;

        try
        {
            var req = new ArticleReservationCreateRequest
            {
                CustomerId = selectedCustomerId,
                ArticleId = selectedArticleId,
                StartDate = fromDate,
                EndDate = untilDate
            };

            await ReservationService.CreateAsync(req);

            message = "Reservation created.";
            await ReloadAll();
        }
        catch (HttpRequestException)
        {
            error = "The API is not reachable. Please try again later.";
        }
        catch (UnauthorizedAccessException)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task DeleteReservation(ArticleReservationDto reservation)
    {
        error = null;
        message = null;

        isBusy = true;

        try
        {
            await ReservationService.DeleteAsync(reservation.Id);
            message = "Reservation deleted.";
            await ReloadAll();
        }
        catch (HttpRequestException)
        {
            error = "The API is not reachable. Please try again later.";
        }
        catch (UnauthorizedAccessException)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private static string FormatUntil(DateTime until)
        => until == DateTime.MinValue ? "-" : until.ToString("yyyy-MM-dd");
}
