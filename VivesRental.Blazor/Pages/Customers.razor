@page "/customers"
@attribute [Authorize]

@using VivesRental.Blazor.Models
@inject VivesRental.Blazor.Services.CustomerService CustomerService
@inject NavigationManager Nav

<h1>Customers</h1>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="GoNew">New customer</button>
</div>

@if (loading)
{
    <p><em>Loading...</em></p>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger d-flex justify-content-between align-items-center">
        <span>@error</span>
        <button class="btn btn-sm btn-outline-light" @onclick="Reload">Retry</button>
    </div>
}
else if (customers.Count == 0)
{
    <p>No customers found.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Orders</th>
                <th>Pending</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in customers)
            {
                <tr>
                    <td>@c.FirstName @c.LastName</td>
                    <td>@c.Email</td>
                    <td>@c.NumberOfOrders</td>
                    <td>@c.NumberOfPendingOrders</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" href="@($"/customers/{c.Id}")">Detail</a>
                        <a class="btn btn-sm btn-outline-secondary ms-2" href="@($"/customers/{c.Id}/edit")">Edit</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private bool loading = true;
    private string? error;
    private List<CustomerDto> customers = new();

    protected override async Task OnInitializedAsync()
    {
        await Reload();
    }

    private async Task Reload()
    {
        loading = true;
        error = null;

        try
        {
            customers = await CustomerService.GetCustomersAsync();
        }
        catch (UnauthorizedAccessException)
        {
            error = "You are not authorized. Please login first.";
        }
        catch (HttpRequestException)
        {
            error = "The API is not reachable. Please try again later.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private void GoNew()
    {
        Nav.NavigateTo("/customers/new");
    }
}
