<div class="alert alert-danger d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2">
    <div>
        <strong>@Title</strong>
        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <div>@Message</div>
        }
    </div>

    @if (OnRetry.HasDelegate)
    {
        <button class="btn btn-sm btn-outline-light" @onclick="OnRetry">
            Retry
        </button>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = "Something went wrong";
    [Parameter] public string? Message { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }
}
